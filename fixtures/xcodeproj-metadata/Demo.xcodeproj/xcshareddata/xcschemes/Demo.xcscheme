<?xml version="1.0" encoding="UTF-8"?>
<Scheme LastUpgradeVersion="1600" version="1.7">
  <BuildAction parallelizeBuildables="YES" buildImplicitDependencies="YES">
    <PreActions>
      <ExecutionAction ActionType="Xcode.IDEStandardExecutionActionsCore.ExecutionActionType.ShellScriptAction">
        <ActionContent title="iTestAgent sentinel — must never run during metadata discovery" scriptText="touch &quot;$ITESTAGENT_METADATA_SENTINEL&quot;" />
      </ExecutionAction>
    </PreActions>
  </BuildAction>
  <TestAction buildConfiguration="Debug" shouldUseLaunchSchemeArgsEnv="YES">
    <TestPlans>
      <TestPlanReference reference="container:Demo/Smoke.xctestplan" default="YES" />
      <TestPlanReference reference="container:Demo/Regression.xctestplan" />
    </TestPlans>
    <Testables>
      <TestableReference skipped="NO">
        <BuildableReference
          BuildableIdentifier="primary"
          BlueprintIdentifier="DEMO-UI-TESTS"
          BuildableName="DemoUITests.xctest"
          BlueprintName="DemoUITests"
          ReferencedContainer="container:Demo.xcodeproj" />
      </TestableReference>
    </Testables>
  </TestAction>
</Scheme>
