# Dependencies
node_modules/
# npm lockfile (project uses Bun → bun.lockb, not package-lock.json)
package-lock.json

# Build output
dist/
build/
*.tsbuildinfo

# Environment & secrets
.env
.env.*
!.env.example

# OS
.DS_Store
.DS_Store?
._*
Thumbs.db

# Editor & IDE
.vscode/
.idea/
*.swp
*.swo
*~

