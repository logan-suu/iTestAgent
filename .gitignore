.omo/
.opencode/
.superpowers/

# Codex project configuration is shared; local Codex logs/state are not.
.codex/*
!.codex/config.toml
.codex-log/

# Code intelligence (local tool index, never commit)
.codegraph/

# macOS
*.dSYM/

# iOS / Xcode artifacts (project analysis cache, not source)
DerivedData/
*.xcarchive

# Logs
*.log
logs/

# Coverage
coverage/

# Temporary
tmp/
temp/
*.tmp
