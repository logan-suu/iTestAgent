{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://itestagent.dev/schemas/result.schema.json",
  "title": "iTestAgent Run Result",
  "description": "Published JSON Schema for the iTestAgent run result file (result.json). Runtime source of truth: RunResultSchema in packages/itestagent-contracts/src/run-result-contracts.ts (Architecture Design \u00a76.5; AGENTS.md \u00a75 data contracts; ADR-011 device targetKind model). Parity is enforced by packages/itestagent-contracts/test/json-schema-parity.test.ts (B03). Unknown keys are stripped at runtime, so additional properties are not forbidden here.",
  "type": "object",
  "required": [
    "schemaVersion",
    "runId",
    "status",
    "device",
    "execution",
    "cases",
    "metrics",
    "environment",
    "artifactRefs"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "3.0",
      "description": "Result schema version. Current writers emit '3.0' (ADR-034)."
    },
    "runId": {
      "type": "string",
      "description": "Unique run identifier. Must equal the runId of the paired artifact-index.json.",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "parentRunId": {
      "type": "string",
      "minLength": 1,
      "description": "Immediate source run for a rerun child. Must match plan.rerun.parentRunId (ADR-035).",
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "passed",
        "failed",
        "explored",
        "inconclusive",
        "needs_assertion",
        "flaky",
        "blocked",
        "cancelled",
        "infra_failed"
      ],
      "description": "Final run status. Without assertions a run cannot be passed (R5): explored/inconclusive/needs_assertion apply instead."
    },
    "projectProfileRef": {
      "type": "string",
      "description": "Reference path to the ProjectProfile. Required for TestPlan bundles and omitted for FlowReplayPlan bundles (ADR-034)."
    },
    "device": {
      "type": "object",
      "description": "Device the run executed on.",
      "required": [
        "udid",
        "name",
        "model",
        "osVersion",
        "targetKind"
      ],
      "properties": {
        "udid": {
          "type": "string",
          "description": "Device UDID."
        },
        "name": {
          "type": "string",
          "description": "Human-readable device name."
        },
        "model": {
          "type": "string",
          "description": "Hardware model identifier (e.g. iPhone15,2)."
        },
        "osVersion": {
          "type": "string",
          "description": "OS version on the device."
        },
        "targetKind": {
          "type": "string",
          "enum": [
            "physical",
            "simulator"
          ],
          "description": "Execution target domain (ADR-011: physical and Simulator are first-class)."
        },
        "runtimeIdentifier": {
          "type": "string",
          "description": "CoreSimulator runtime identifier (simulator only; absent for physical)."
        }
      }
    },
    "execution": {
      "type": "object",
      "description": "Execution summary for the whole run.",
      "required": [
        "totalSteps",
        "completedSteps",
        "failedSteps",
        "skippedSteps",
        "durationMs",
        "startTime",
        "endTime",
        "targetKind",
        "backendUsed",
        "deviceId"
      ],
      "properties": {
        "totalSteps": {
          "type": "integer",
          "minimum": 0
        },
        "completedSteps": {
          "type": "integer",
          "minimum": 0
        },
        "failedSteps": {
          "type": "integer",
          "minimum": 0
        },
        "skippedSteps": {
          "type": "integer",
          "minimum": 0
        },
        "durationMs": {
          "type": "integer",
          "minimum": 0,
          "description": "Total wall-clock duration in milliseconds."
        },
        "startTime": {
          "type": "string",
          "description": "Start timestamp (ISO 8601)."
        },
        "endTime": {
          "type": "string",
          "description": "End timestamp (ISO 8601)."
        },
        "mode": {
          "type": "string",
          "enum": [
            "xcuitest",
            "device_backend"
          ],
          "description": "Execution mode (ADR-011): XCUITest run or DeviceBackend exploration."
        },
        "targetKind": {
          "type": "string",
          "enum": [
            "physical",
            "simulator"
          ],
          "description": "Execution target domain (ADR-011)."
        },
        "backendUsed": {
          "type": "string",
          "description": "Name of the backend that executed the run."
        },
        "backendVersion": {
          "type": "string",
          "description": "Backend version (audit purposes)."
        },
        "deviceId": {
          "type": "string",
          "description": "Target device identifier used for this run."
        }
      }
    },
    "cleanupOutcome": {
      "type": "object",
      "description": "Optional owner cleanup result. It does not replace the primary execution status or facts.",
      "required": [
        "status",
        "reusable",
        "issues"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "closed",
            "already_closed",
            "timed_out",
            "failed"
          ]
        },
        "reusable": {
          "type": "boolean"
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "cases": {
      "type": "array",
      "description": "Per-test-case results. caseId values must be unique (enforced by json-schema-cross-field.ts).",
      "items": {
        "type": "object",
        "required": [
          "caseId",
          "name",
          "status",
          "steps",
          "durationMs",
          "artifacts"
        ],
        "properties": {
          "caseId": {
            "type": "string",
            "description": "Unique case identifier."
          },
          "name": {
            "type": "string",
            "description": "Human-readable case name."
          },
          "status": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "explored",
              "inconclusive",
              "needs_assertion",
              "flaky",
              "blocked",
              "cancelled"
            ],
            "description": "Case execution status."
          },
          "steps": {
            "type": "array",
            "description": "Related step IDs.",
            "items": {
              "type": "string"
            }
          },
          "durationMs": {
            "type": "integer",
            "minimum": 0,
            "description": "Case duration in milliseconds."
          },
          "error": {
            "type": "string",
            "description": "Error message (filled on failure)."
          },
          "artifacts": {
            "type": "array",
            "description": "Artifact ID references (not full ArtifactRef objects).",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "description": "Normalized performance metrics. Uncertain values MUST carry approximate:true (R5: no silent degradation or fabricated metrics). FPS is approximate by nature.",
      "properties": {
        "testDurationMs": {
          "type": "integer",
          "minimum": 0
        },
        "memoryLeaks": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "source",
                "status",
                "scope",
                "allocationCount",
                "totalBytes"
              ],
              "properties": {
                "source": {
                  "const": "xctrace-leaks-detail"
                },
                "status": {
                  "const": "detected"
                },
                "scope": {
                  "const": "observed_allocations"
                },
                "allocationCount": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10000
                },
                "totalBytes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                }
              }
            },
            {
              "type": "object",
              "required": [
                "source",
                "status",
                "scope",
                "allocationCount",
                "totalBytes",
                "startedAt",
                "finishedAt",
                "exitCode",
                "completionVerified",
                "targetBound",
                "artifactId"
              ],
              "additionalProperties": false,
              "properties": {
                "source": {
                  "const": "native-leaks"
                },
                "status": {
                  "enum": [
                    "detected",
                    "not_detected"
                  ]
                },
                "scope": {
                  "const": "scan_snapshot"
                },
                "allocationCount": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "totalBytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "startedAt": {
                  "type": "string",
                  "format": "date-time"
                },
                "finishedAt": {
                  "type": "string",
                  "format": "date-time"
                },
                "exitCode": {
                  "enum": [
                    0,
                    1
                  ]
                },
                "completionVerified": {
                  "const": true
                },
                "targetBound": {
                  "const": true
                },
                "artifactId": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "status": {
                        "const": "not_detected"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "exitCode": {
                        "const": 0
                      },
                      "allocationCount": {
                        "const": 0
                      },
                      "totalBytes": {
                        "const": 0
                      }
                    }
                  },
                  "else": {
                    "properties": {
                      "exitCode": {
                        "const": 1
                      },
                      "allocationCount": {
                        "minimum": 1
                      },
                      "totalBytes": {
                        "minimum": 1
                      }
                    }
                  }
                }
              ]
            }
          ]
        },
        "memoryGrowth": {
          "type": "object",
          "required": [
            "source",
            "approximate",
            "scope",
            "samples",
            "sampleCount",
            "startMiB",
            "endMiB",
            "peakMiB",
            "deltaMiB",
            "durationMs",
            "rateMiBPerMinute",
            "direction"
          ],
          "properties": {
            "source": {
              "enum": [
                "activity-monitor-process-live",
                "native-footprint"
              ]
            },
            "approximate": {
              "const": true
            },
            "scope": {
              "const": "observed_interval"
            },
            "recordingDurationMs": {
              "type": "number",
              "minimum": 0
            },
            "coverage": {
              "enum": [
                "complete",
                "partial"
              ]
            },
            "samples": {
              "type": "array",
              "minItems": 2,
              "maxItems": 10000,
              "items": {
                "type": "object",
                "required": [
                  "timestampMs",
                  "footprintMiB"
                ],
                "properties": {
                  "timestampMs": {
                    "type": "number",
                    "minimum": 0
                  },
                  "footprintMiB": {
                    "type": "number",
                    "minimum": 0
                  },
                  "measurementDurationMs": {
                    "type": "number",
                    "minimum": 0
                  }
                }
              }
            },
            "sampleCount": {
              "type": "integer",
              "minimum": 2
            },
            "startMiB": {
              "type": "number",
              "minimum": 0
            },
            "endMiB": {
              "type": "number",
              "minimum": 0
            },
            "peakMiB": {
              "type": "number",
              "minimum": 0
            },
            "deltaMiB": {
              "type": "number"
            },
            "durationMs": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "rateMiBPerMinute": {
              "type": "number"
            },
            "direction": {
              "enum": [
                "increased",
                "decreased",
                "unchanged"
              ]
            },
            "sampleTimestamp": {
              "const": "host_command_completed"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "source": {
                    "const": "native-footprint"
                  }
                }
              },
              "then": {
                "required": [
                  "sampleTimestamp"
                ],
                "properties": {
                  "samples": {
                    "items": {
                      "required": [
                        "measurementDurationMs"
                      ]
                    }
                  }
                }
              }
            }
          ]
        },
        "collection": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "metric",
              "status",
              "reasonCode"
            ],
            "properties": {
              "metric": {
                "type": "string",
                "enum": [
                  "launch_time",
                  "memory_peak",
                  "memory_growth",
                  "memory_leaks",
                  "crash",
                  "test_duration",
                  "hitches",
                  "fps",
                  "xctrace_summary"
                ]
              },
              "status": {
                "type": "string",
                "enum": [
                  "collected",
                  "not_exportable",
                  "failed",
                  "cancelled"
                ]
              },
              "reasonCode": {
                "type": "string",
                "pattern": "^[a-z0-9_.]+$"
              }
            }
          }
        },
        "launchDurationMs": {
          "type": "integer",
          "minimum": 0,
          "description": "App launch duration in milliseconds."
        },
        "memoryPeakMB": {
          "type": "number",
          "minimum": 0,
          "description": "Legacy peak-memory field; memoryPeakUnit identifies explicitly measured units."
        },
        "memoryPeakUnit": {
          "type": "string",
          "enum": [
            "MB",
            "MiB"
          ]
        },
        "crashDetected": {
          "type": "boolean",
          "description": "Whether a crash was detected during the run."
        },
        "hangCount": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of hangs observed."
        },
        "hitchesSummary": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "inconclusive"
          ],
          "description": "Coarse hitches severity level."
        },
        "fpsApproximate": {
          "type": "number",
          "minimum": 0,
          "description": "Approximate FPS value (never exact; R5)."
        },
        "approximate": {
          "type": "boolean",
          "description": "True when any metric is approximate/estimated (R5 annotation)."
        },
        "rawTracePath": {
          "type": "string",
          "description": "Optional raw .trace file path for later drill-down."
        },
        "memoryRounds": {
          "type": "object",
          "properties": {
            "policy": {
              "type": "string",
              "const": "memory-rounds-v1"
            },
            "status": {
              "type": "string",
              "enum": [
                "passed",
                "failed",
                "blocked",
                "cancelled",
                "inconclusive"
              ]
            },
            "plannedCount": {
              "type": "integer",
              "minimum": 2,
              "maximum": 10
            },
            "rounds": {
              "minItems": 2,
              "maxItems": 10,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "round": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 10
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "passed",
                      "failed",
                      "blocked",
                      "cancelled",
                      "inconclusive",
                      "not_started"
                    ]
                  },
                  "reasonCode": {
                    "type": "string",
                    "pattern": "^[a-z0-9_.]+$"
                  },
                  "startedAt": {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
                  },
                  "finishedAt": {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
                  },
                  "stepIds": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "artifactIds": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "memoryPeakMB": {
                    "type": "number",
                    "minimum": 0
                  },
                  "memoryGrowth": {
                    "type": "object",
                    "properties": {
                      "source": {
                        "type": "string",
                        "const": "activity-monitor-process-live"
                      },
                      "approximate": {
                        "type": "boolean",
                        "const": true
                      },
                      "scope": {
                        "type": "string",
                        "const": "observed_interval"
                      },
                      "recordingDurationMs": {
                        "type": "number",
                        "minimum": 0
                      },
                      "coverage": {
                        "type": "string",
                        "enum": [
                          "complete",
                          "partial"
                        ]
                      },
                      "samples": {
                        "minItems": 2,
                        "maxItems": 10000,
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "timestampMs": {
                              "type": "number",
                              "minimum": 0
                            },
                            "footprintMiB": {
                              "type": "number",
                              "minimum": 0
                            }
                          },
                          "required": [
                            "timestampMs",
                            "footprintMiB"
                          ]
                        }
                      },
                      "sampleCount": {
                        "type": "integer",
                        "minimum": 2,
                        "maximum": 9007199254740991
                      },
                      "startMiB": {
                        "type": "number",
                        "minimum": 0
                      },
                      "endMiB": {
                        "type": "number",
                        "minimum": 0
                      },
                      "peakMiB": {
                        "type": "number",
                        "minimum": 0
                      },
                      "deltaMiB": {
                        "type": "number"
                      },
                      "durationMs": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "rateMiBPerMinute": {
                        "type": "number"
                      },
                      "direction": {
                        "type": "string",
                        "enum": [
                          "increased",
                          "decreased",
                          "unchanged"
                        ]
                      }
                    },
                    "required": [
                      "source",
                      "approximate",
                      "scope",
                      "samples",
                      "sampleCount",
                      "startMiB",
                      "endMiB",
                      "peakMiB",
                      "deltaMiB",
                      "durationMs",
                      "rateMiBPerMinute",
                      "direction"
                    ]
                  },
                  "memoryLeaks": {
                    "oneOf": [
                      {
                        "type": "object",
                        "required": [
                          "source",
                          "status",
                          "scope",
                          "allocationCount",
                          "totalBytes"
                        ],
                        "properties": {
                          "source": {
                            "const": "xctrace-leaks-detail"
                          },
                          "status": {
                            "const": "detected"
                          },
                          "scope": {
                            "const": "observed_allocations"
                          },
                          "allocationCount": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 10000
                          },
                          "totalBytes": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 9007199254740991
                          }
                        }
                      },
                      {
                        "type": "object",
                        "required": [
                          "source",
                          "status",
                          "scope",
                          "allocationCount",
                          "totalBytes",
                          "startedAt",
                          "finishedAt",
                          "exitCode",
                          "completionVerified",
                          "targetBound",
                          "artifactId"
                        ],
                        "additionalProperties": false,
                        "properties": {
                          "source": {
                            "const": "native-leaks"
                          },
                          "status": {
                            "enum": [
                              "detected",
                              "not_detected"
                            ]
                          },
                          "scope": {
                            "const": "scan_snapshot"
                          },
                          "allocationCount": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          "totalBytes": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          "startedAt": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "finishedAt": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "exitCode": {
                            "enum": [
                              0,
                              1
                            ]
                          },
                          "completionVerified": {
                            "const": true
                          },
                          "targetBound": {
                            "const": true
                          },
                          "artifactId": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "allOf": [
                          {
                            "if": {
                              "properties": {
                                "status": {
                                  "const": "not_detected"
                                }
                              }
                            },
                            "then": {
                              "properties": {
                                "exitCode": {
                                  "const": 0
                                },
                                "allocationCount": {
                                  "const": 0
                                },
                                "totalBytes": {
                                  "const": 0
                                }
                              }
                            },
                            "else": {
                              "properties": {
                                "exitCode": {
                                  "const": 1
                                },
                                "allocationCount": {
                                  "minimum": 1
                                },
                                "totalBytes": {
                                  "minimum": 1
                                }
                              }
                            }
                          }
                        ]
                      }
                    ]
                  },
                  "collection": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "metric": {
                          "type": "string",
                          "enum": [
                            "launch_time",
                            "memory_peak",
                            "memory_growth",
                            "memory_leaks",
                            "crash",
                            "test_duration",
                            "hitches",
                            "fps",
                            "xctrace_summary"
                          ]
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "collected",
                            "not_exportable",
                            "failed",
                            "cancelled"
                          ]
                        },
                        "reasonCode": {
                          "type": "string",
                          "pattern": "^[a-z0-9_.]+$"
                        }
                      },
                      "required": [
                        "metric",
                        "status",
                        "reasonCode"
                      ]
                    }
                  }
                },
                "required": [
                  "round",
                  "status",
                  "reasonCode",
                  "stepIds",
                  "artifactIds"
                ],
                "additionalProperties": false
              }
            },
            "endpointDeltaMiB": {
              "type": "number"
            }
          },
          "required": [
            "policy",
            "status",
            "plannedCount",
            "rounds"
          ],
          "additionalProperties": false,
          "description": "Independent confirmed Flow rounds. Ordered counts, stop semantics, endpoints, sampled values and cross-document references are additionally enforced by parseValidatedRunBundle (ADR-042)."
        },
        "memoryPeakSource": {
          "enum": [
            "activity-monitor-process-live",
            "native-footprint"
          ]
        }
      }
    },
    "environment": {
      "type": "object",
      "description": "Run environment metadata (ADR-011: mandatory for Simulator runs).",
      "required": [
        "targetKind",
        "representativeOfPhysicalDevice",
        "comparisonScope"
      ],
      "properties": {
        "targetKind": {
          "type": "string",
          "enum": [
            "physical",
            "simulator"
          ]
        },
        "representativeOfPhysicalDevice": {
          "type": "boolean",
          "description": "Whether results represent physical-device behavior (always false for Simulator)."
        },
        "comparisonScope": {
          "type": "string",
          "enum": [
            "simulator_only",
            "physical_only"
          ],
          "description": "Baseline comparison domain (baselines never cross domains, ADR-011)."
        },
        "hostFingerprint": {
          "type": "string",
          "description": "Host machine fingerprint (required for Simulator runs)."
        },
        "xcodeVersion": {
          "type": "string",
          "description": "Xcode version (required for Simulator runs)."
        }
      }
    },
    "baselineDelta": {
      "type": "object",
      "description": "Delta versus the local baseline. Omitted on the first run (no baseline yet). Baselines are only created by successful runs and never cross comparisonScope domains.",
      "required": [
        "baselineId",
        "runId",
        "comparedAt",
        "targetKind",
        "deltas",
        "summary"
      ],
      "properties": {
        "baselineId": {
          "type": "string",
          "description": "Baseline identifier compared against."
        },
        "runId": {
          "type": "string",
          "description": "Run ID that produced the baseline.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "comparedAt": {
          "type": "string",
          "description": "Comparison timestamp (ISO 8601)."
        },
        "targetKind": {
          "type": "string",
          "enum": [
            "physical",
            "simulator"
          ],
          "description": "Comparison domain (ADR-011 \u00a76: baselines are domain-isolated)."
        },
        "deltas": {
          "type": "object",
          "description": "Per-metric deltas. Signed numbers: positive = regression.",
          "properties": {
            "memoryGrowthMiB": {
              "type": "number"
            },
            "launchDurationMs": {
              "type": "number",
              "description": "Launch duration delta in ms."
            },
            "memoryPeakMB": {
              "type": "number",
              "description": "Peak memory delta in MB."
            },
            "hangCount": {
              "type": "number",
              "description": "Hang count delta."
            },
            "hitches": {
              "type": "string",
              "enum": [
                "improved",
                "regressed",
                "unchanged",
                "inconclusive"
              ],
              "description": "Hitches trend."
            },
            "fpsApproximate": {
              "type": "number",
              "description": "Approximate FPS delta; negative = regression (FPS drop)."
            }
          }
        },
        "summary": {
          "type": "string",
          "enum": [
            "improved",
            "regressed",
            "unchanged",
            "inconclusive"
          ],
          "description": "Overall verdict."
        }
      }
    },
    "artifactRefs": {
      "type": "array",
      "description": "Artifact IDs into the paired artifact-index.json. Entries must be unique and each must resolve to an index id (enforced by json-schema-cross-field.ts).",
      "items": {
        "type": "string"
      }
    },
    "explanation": {
      "type": "object",
      "description": "Failure explanation (omitted when passed). Evidence-driven attribution; no fabrication (R5).",
      "required": [
        "explanationType",
        "summary",
        "evidence"
      ],
      "properties": {
        "explanationType": {
          "type": "string",
          "enum": [
            "product_regression",
            "script_issue",
            "device_issue",
            "env_issue",
            "flaky",
            "perf_regression",
            "inconclusive"
          ],
          "description": "Failure classification."
        },
        "summary": {
          "type": "string",
          "description": "Human-readable failure summary."
        },
        "evidence": {
          "type": "array",
          "description": "Supporting evidence list (artifact IDs or log excerpts).",
          "items": {
            "type": "string"
          }
        },
        "suggestedActions": {
          "type": "array",
          "description": "Suggested remediation actions.",
          "items": {
            "type": "string"
          }
        },
        "confidence": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "description": "Confidence level of the attribution."
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": "3.0"
          }
        }
      },
      "then": {
        "properties": {
          "execution": {
            "required": [
              "mode"
            ]
          }
        }
      }
    },
    {
      "if": {
        "anyOf": [
          {
            "properties": {
              "metrics": {
                "required": [
                  "memoryPeakSource"
                ],
                "properties": {
                  "memoryPeakSource": {
                    "const": "native-footprint"
                  }
                }
              }
            }
          },
          {
            "properties": {
              "metrics": {
                "required": [
                  "memoryGrowth"
                ],
                "properties": {
                  "memoryGrowth": {
                    "required": [
                      "source"
                    ],
                    "properties": {
                      "source": {
                        "const": "native-footprint"
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "properties": {
              "metrics": {
                "required": [
                  "memoryLeaks"
                ],
                "properties": {
                  "memoryLeaks": {
                    "required": [
                      "source"
                    ],
                    "properties": {
                      "source": {
                        "const": "native-leaks"
                      }
                    }
                  }
                }
              }
            }
          }
        ]
      },
      "then": {
        "not": {
          "required": [
            "baselineDelta"
          ]
        },
        "properties": {
          "device": {
            "properties": {
              "targetKind": {
                "const": "simulator"
              }
            }
          },
          "execution": {
            "properties": {
              "targetKind": {
                "const": "simulator"
              }
            }
          },
          "environment": {
            "properties": {
              "targetKind": {
                "const": "simulator"
              },
              "representativeOfPhysicalDevice": {
                "const": false
              },
              "comparisonScope": {
                "const": "simulator_only"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "metrics": {
            "required": [
              "memoryPeakSource"
            ],
            "properties": {
              "memoryPeakSource": {
                "const": "native-footprint"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "metrics": {
            "required": [
              "memoryPeakMB",
              "memoryPeakUnit"
            ],
            "properties": {
              "memoryPeakUnit": {
                "const": "MiB"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "metrics": {
            "required": [
              "memoryGrowth",
              "memoryPeakMB"
            ],
            "properties": {
              "memoryGrowth": {
                "properties": {
                  "source": {
                    "const": "native-footprint"
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "metrics": {
            "required": [
              "memoryPeakSource"
            ],
            "properties": {
              "memoryPeakSource": {
                "const": "native-footprint"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "metrics": {
            "required": [
              "memoryPeakSource",
              "memoryGrowth"
            ],
            "properties": {
              "memoryPeakSource": {
                "const": "native-footprint"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "metrics": {
            "properties": {
              "memoryGrowth": {
                "properties": {
                  "source": {
                    "const": "native-footprint"
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
