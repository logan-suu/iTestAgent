{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://itestagent.dev/schemas/result.schema.json",
  "title": "iTestAgent Run Result",
  "description": "Published JSON Schema for the iTestAgent run result file (result.json). Runtime source of truth: RunResultSchema in packages/itestagent-contracts/src/run-result-contracts.ts (Architecture Design §6.5; AGENTS.md §5 data contracts; ADR-011 device targetKind model). Parity is enforced by packages/itestagent-contracts/test/json-schema-parity.test.ts (B03). Unknown keys are stripped at runtime, so additional properties are not forbidden here.",
  "type": "object",
  "required": [
    "schemaVersion",
    "runId",
    "status",
    "projectProfileRef",
    "device",
    "execution",
    "cases",
    "metrics",
    "environment",
    "artifactRefs"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "description": "Result schema version. Current writers emit '2.0' (DEFAULT_SCHEMA_VERSION); v1 documents are migrated by migrateV1ToV2 (ADR-011 §8)."
    },
    "runId": {
      "type": "string",
      "description": "Unique run identifier. Must equal the runId of the paired artifact-index.json."
    },
    "status": {
      "type": "string",
      "enum": [
        "passed",
        "failed",
        "explored",
        "inconclusive",
        "needs_assertion",
        "flaky",
        "blocked"
      ],
      "description": "Final run status. Without assertions a run cannot be passed (R5): explored/inconclusive/needs_assertion apply instead."
    },
    "projectProfileRef": {
      "type": "string",
      "description": "Reference path to the ProjectProfile this run was planned from."
    },
    "device": {
      "type": "object",
      "description": "Device the run executed on.",
      "required": ["udid", "name", "model", "osVersion", "targetKind"],
      "properties": {
        "udid": { "type": "string", "description": "Device UDID." },
        "name": { "type": "string", "description": "Human-readable device name." },
        "model": { "type": "string", "description": "Hardware model identifier (e.g. iPhone15,2)." },
        "osVersion": { "type": "string", "description": "OS version on the device." },
        "targetKind": {
          "type": "string",
          "enum": ["physical", "simulator"],
          "description": "Execution target domain (ADR-011: physical and Simulator are first-class)."
        },
        "runtimeIdentifier": {
          "type": "string",
          "description": "CoreSimulator runtime identifier (simulator only; absent for physical)."
        }
      }
    },
    "execution": {
      "type": "object",
      "description": "Execution summary for the whole run.",
      "required": [
        "totalSteps",
        "completedSteps",
        "failedSteps",
        "skippedSteps",
        "durationMs",
        "startTime",
        "endTime",
        "targetKind",
        "backendUsed",
        "deviceId"
      ],
      "properties": {
        "totalSteps": { "type": "integer", "minimum": 0 },
        "completedSteps": { "type": "integer", "minimum": 0 },
        "failedSteps": { "type": "integer", "minimum": 0 },
        "skippedSteps": { "type": "integer", "minimum": 0 },
        "durationMs": { "type": "integer", "minimum": 0, "description": "Total wall-clock duration in milliseconds." },
        "startTime": { "type": "string", "description": "Start timestamp (ISO 8601)." },
        "endTime": { "type": "string", "description": "End timestamp (ISO 8601)." },
        "mode": {
          "type": "string",
          "enum": ["xcuitest", "device_backend"],
          "description": "Execution mode (ADR-011): XCUITest run or DeviceBackend exploration."
        },
        "targetKind": {
          "type": "string",
          "enum": ["physical", "simulator"],
          "description": "Execution target domain (ADR-011)."
        },
        "backendUsed": { "type": "string", "description": "Name of the backend that executed the run." },
        "backendVersion": { "type": "string", "description": "Backend version (audit purposes)." },
        "deviceId": { "type": "string", "description": "Target device identifier used for this run." }
      }
    },
    "cases": {
      "type": "array",
      "description": "Per-test-case results. caseId values must be unique (enforced by json-schema-cross-field.ts).",
      "items": {
        "type": "object",
        "required": ["caseId", "name", "status", "steps", "durationMs", "artifacts"],
        "properties": {
          "caseId": { "type": "string", "description": "Unique case identifier." },
          "name": { "type": "string", "description": "Human-readable case name." },
          "status": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "explored",
              "inconclusive",
              "needs_assertion",
              "flaky",
              "blocked"
            ],
            "description": "Case execution status."
          },
          "steps": {
            "type": "array",
            "description": "Related step IDs.",
            "items": { "type": "string" }
          },
          "durationMs": { "type": "integer", "minimum": 0, "description": "Case duration in milliseconds." },
          "error": { "type": "string", "description": "Error message (filled on failure)." },
          "artifacts": {
            "type": "array",
            "description": "Artifact ID references (not full ArtifactRef objects).",
            "items": { "type": "string" }
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "description": "Normalized performance metrics. Uncertain values MUST carry approximate:true (R5: no silent degradation or fabricated metrics). FPS is approximate by nature.",
      "properties": {
        "launchDurationMs": { "type": "integer", "minimum": 0, "description": "App launch duration in milliseconds." },
        "memoryPeakMB": { "type": "number", "minimum": 0, "description": "Peak memory in MB." },
        "crashDetected": { "type": "boolean", "description": "Whether a crash was detected during the run." },
        "hangCount": { "type": "integer", "minimum": 0, "description": "Number of hangs observed." },
        "hitchesSummary": {
          "type": "string",
          "enum": ["low", "medium", "high", "inconclusive"],
          "description": "Coarse hitches severity level."
        },
        "fpsApproximate": { "type": "number", "minimum": 0, "description": "Approximate FPS value (never exact; R5)." },
        "approximate": { "type": "boolean", "description": "True when any metric is approximate/estimated (R5 annotation)." },
        "rawTracePath": { "type": "string", "description": "Optional raw .trace file path for later drill-down." }
      }
    },
    "environment": {
      "type": "object",
      "description": "Run environment metadata (ADR-011: mandatory for Simulator runs).",
      "required": ["targetKind", "representativeOfPhysicalDevice", "comparisonScope"],
      "properties": {
        "targetKind": {
          "type": "string",
          "enum": ["physical", "simulator"]
        },
        "representativeOfPhysicalDevice": {
          "type": "boolean",
          "description": "Whether results represent physical-device behavior (always false for Simulator)."
        },
        "comparisonScope": {
          "type": "string",
          "enum": ["simulator_only", "physical_only"],
          "description": "Baseline comparison domain (baselines never cross domains, ADR-011)."
        },
        "hostFingerprint": { "type": "string", "description": "Host machine fingerprint (required for Simulator runs)." },
        "xcodeVersion": { "type": "string", "description": "Xcode version (required for Simulator runs)." }
      }
    },
    "baselineDelta": {
      "type": "object",
      "description": "Delta versus the local baseline. Omitted on the first run (no baseline yet). Baselines are only created by successful runs and never cross comparisonScope domains.",
      "required": ["baselineId", "runId", "comparedAt", "targetKind", "deltas", "summary"],
      "properties": {
        "baselineId": { "type": "string", "description": "Baseline identifier compared against." },
        "runId": { "type": "string", "description": "Run ID that produced the baseline." },
        "comparedAt": { "type": "string", "description": "Comparison timestamp (ISO 8601)." },
        "targetKind": {
          "type": "string",
          "enum": ["physical", "simulator"],
          "description": "Comparison domain (ADR-011 §6: baselines are domain-isolated)."
        },
        "deltas": {
          "type": "object",
          "description": "Per-metric deltas. Signed numbers: positive = regression.",
          "properties": {
            "launchDurationMs": { "type": "number", "description": "Launch duration delta in ms." },
            "memoryPeakMB": { "type": "number", "description": "Peak memory delta in MB." },
            "hangCount": { "type": "number", "description": "Hang count delta." },
            "hitches": {
              "type": "string",
              "enum": ["improved", "regressed", "unchanged", "inconclusive"],
              "description": "Hitches trend."
            },
            "fpsApproximate": { "type": "number", "description": "Approximate FPS delta; negative = regression (FPS drop)." }
          }
        },
        "summary": {
          "type": "string",
          "enum": ["improved", "regressed", "unchanged", "inconclusive"],
          "description": "Overall verdict."
        }
      }
    },
    "artifactRefs": {
      "type": "array",
      "description": "Artifact IDs into the paired artifact-index.json. Entries must be unique and each must resolve to an index id (enforced by json-schema-cross-field.ts).",
      "items": { "type": "string" }
    },
    "explanation": {
      "type": "object",
      "description": "Failure explanation (omitted when passed). Evidence-driven attribution; no fabrication (R5).",
      "required": ["explanationType", "summary", "evidence"],
      "properties": {
        "explanationType": {
          "type": "string",
          "enum": [
            "product_regression",
            "script_issue",
            "device_issue",
            "env_issue",
            "flaky",
            "perf_regression",
            "inconclusive"
          ],
          "description": "Failure classification."
        },
        "summary": { "type": "string", "description": "Human-readable failure summary." },
        "evidence": {
          "type": "array",
          "description": "Supporting evidence list (artifact IDs or log excerpts).",
          "items": { "type": "string" }
        },
        "suggestedActions": {
          "type": "array",
          "description": "Suggested remediation actions.",
          "items": { "type": "string" }
        },
        "confidence": {
          "type": "string",
          "enum": ["high", "medium", "low"],
          "description": "Confidence level of the attribution."
        }
      }
    }
  }
}
