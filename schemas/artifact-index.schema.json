{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://itestagent.dev/schemas/artifact-index.schema.json",
  "title": "iTestAgent Artifact Index",
  "description": "Published JSON Schema for the iTestAgent artifact index file (artifact-index.json). Runtime source of truth: ArtifactIndexSchema in packages/itestagent-contracts/src/artifact-index-contract.ts (Architecture Design §6.6; AGENTS.md §5 data contracts). Parity is enforced by packages/itestagent-contracts/test/json-schema-parity.test.ts (B03). Unknown keys are stripped at runtime, so additional properties are not forbidden here.",
  "type": "object",
  "required": [
    "schemaVersion",
    "runId",
    "artifacts",
    "collectionOutcomes"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "2.0",
      "description": "Artifact-index schema version. Current writers emit 2.0 (ADR-034)."
    },
    "runId": {
      "type": "string",
      "description": "Run this index belongs to. Must equal the runId of the paired result.json.",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "artifacts": {
      "type": "array",
      "description": "Metadata for every artifact collected during the run. Artifact ids must be unique within one index (enforced by json-schema-cross-field.ts).",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "path",
          "redactionStatus"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Stable artifact identifier, referenced by result.json artifactRefs[]."
          },
          "type": {
            "type": "string",
            "enum": [
              "screenshot",
              "video",
              "uitree",
              "log",
              "syslog",
              "crashlog",
              "trace",
              "xcresult",
              "json",
              "text"
            ],
            "description": "Artifact type."
          },
          "path": {
            "type": "string",
            "description": "Path relative to the run directory."
          },
          "mimeType": {
            "type": "string",
            "description": "MIME type (e.g. image/png)."
          },
          "sizeBytes": {
            "type": "integer",
            "minimum": 0,
            "description": "File size in bytes."
          },
          "sha256": {
            "type": "string",
            "description": "SHA-256 checksum of the file contents."
          },
          "relatedStep": {
            "type": "string",
            "description": "Run step ID that produced this artifact."
          },
          "relatedCase": {
            "type": "string",
            "description": "Test case ID this artifact proves."
          },
          "backend": {
            "type": "string",
            "description": "Backend that produced this artifact."
          },
          "redactionStatus": {
            "type": "string",
            "enum": [
              "raw-local-only",
              "redacted",
              "safe"
            ],
            "description": "R6 redaction state: raw-local-only stays on the local machine only; redacted has sensitive content scrubbed; safe contains no sensitive content."
          }
        }
      }
    },
    "collectionOutcomes": {
      "type": "array",
      "description": "Evidence slots evaluated for this run, including unsuccessful collection.",
      "items": {
        "type": "object",
        "required": [
          "type",
          "status",
          "reasonCode"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "collected"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "required": [
                "artifactId"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "not_requested",
                    "not_applicable",
                    "unsupported",
                    "failed"
                  ]
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "not": {
                "required": [
                  "artifactId"
                ]
              }
            }
          }
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "screenshot",
              "video",
              "uitree",
              "log",
              "syslog",
              "crashlog",
              "trace",
              "xcresult",
              "json",
              "text"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "collected",
              "not_requested",
              "not_applicable",
              "unsupported",
              "failed"
            ]
          },
          "reasonCode": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string"
          },
          "artifactId": {
            "type": "string",
            "minLength": 1
          },
          "relatedStep": {
            "type": "string",
            "minLength": 1
          },
          "relatedCase": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
