{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MemoryProfileScenario",
  "type": "object",
  "properties": {
    "kind": { "const": "memory-profile" },
    "runId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    }
  },
  "required": ["kind", "runId"]
}
